# Copy to .env and fill in. Never commit or zip .env.
# --- LLM: local Ollama only (the wrapper refuses "cloud" models and non-localhost hosts)
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:latest
OLLAMA_HOST=http://localhost:11434
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=2048
LLM_TIMEOUT_S=300
LLM_SEED=42
LLM_KEEP_ALIVE=30m
# --- Evidence preprocessing
MAX_IMAGE_SIDE=1600
PDF_DPI=150
# --- Phase 6 only (Hugging Face Spaces upload). Leave empty until then.
HF_TOKEN=
